# Copy this file to .env and fill in real values.
# .env is excluded by .gitignore. Never commit it or paste its contents anywhere.

# Your Okta org URL, no trailing slash. Example: https://integrator-1234567.okta.com
OKTA_ORG_URL=https://your-org.okta.com

# OIDC app (Part 2)
OIDC_CLIENT_ID=replace-me
OIDC_CLIENT_SECRET=replace-me
OIDC_REDIRECT_URI=http://localhost:5000/authorization-code/callback

# Flask session signing key (Part 2). Generate one with:
#   py -c "import secrets; print(secrets.token_hex(32))"
FLASK_SECRET_KEY=replace-me

# SAML service provider (Part 3)
SAML_IDP_METADATA_URL=replace-me
